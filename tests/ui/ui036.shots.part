// ---- screenshots: 10 themes x desktop / 1080p / 4k / phone, plus K5, K10, K11, K13, K14, K22 in every theme ----
{
  const SV = [['desktop', { viewport: { width: 1280, height: 720 } }], ['1080p', VPS[0][1]], ['4k', VPS[3][1]], ['phone', VPS[2][1]]];
  const OUT = (th, n) => `/workspace/screens/wavwiz-036-${ENG === 'webkit' ? 'webkit-' : ''}${th}-${n}.png`;
  for (const th of THEMES) {
    for (const [tag, opt] of SV) await step(`shots ${th} ${tag}`, async () => {
      const { ctx, p } = await newPage(opt); await home(p, NORMAL, th); await p.screenshot({ path: OUT(th, tag) }); ok(`shot ${th} ${tag}`, p._errs.length === 0, p._errs.join('|')); await ctx.close(); });
    await step(`state shots ${th}`, async () => {
      const { ctx, p } = await newPage({ viewport: { width: 1920, height: 1080 } });
      await home(p, { ...NORMAL, exp: 'dev' }, th); await p.locator('.devpanel .scol .dcard.dc3 .dname').first().click({ timeout: 5000 }).catch(() => {}); await p.waitForTimeout(900); await p.screenshot({ path: OUT(th, 'k5-speaker-settings') });
      await home(p, NORMAL, th); await p.click('.plpick').catch(() => {}); await p.waitForTimeout(300); await p.screenshot({ path: OUT(th, 'k10-columns') }); await p.keyboard.press('Escape'); await p.click('.pllock').catch(() => {}); await p.waitForTimeout(300); await p.screenshot({ path: OUT(th, 'k10-locked') });
      await home(p, NORMAL, th); await p.evaluate(() => localStorage.setItem('wavwiz.center.v1', 'eq')); await p.reload(); await p.waitForTimeout(3500); await closeDlg(p); await p.screenshot({ path: OUT(th, 'k11-eq-leds') });
      await p.evaluate(() => localStorage.setItem('wavwiz.center.v1', 'viz')); await p.reload(); await p.waitForTimeout(3000); await closeDlg(p); await p.screenshot({ path: OUT(th, 'k13-vu-viz') });
      await home(p, { ...NORMAL, exp: 'lib' }, th); await p.waitForTimeout(500); await p.screenshot({ path: OUT(th, 'k14-library-mini') });
      await home(p, { ...NORMAL, list: 'expanded', dev: 'rail' }, th); await p.waitForTimeout(500); await p.screenshot({ path: OUT(th, 'k22-mini-rail') });
      await ctx.close(); });
  }
}
