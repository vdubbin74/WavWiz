<Project>
  <!-- THE one place the version lives (spec 0.4). All builds are BETA (0.0.x, then 0.1.x) until the first full release 1.0.0.
       The installer, binaries' file version, About box, tray tooltip, web UI and API appVersion all read this. -->
  <PropertyGroup>
    <WavWizVersion>0.1.3</WavWizVersion>
    <WavWizChannel>BETA</WavWizChannel>
    <Version>$(WavWizVersion)</Version>
    <AssemblyVersion>$(WavWizVersion).0</AssemblyVersion>
    <FileVersion>$(WavWizVersion).0</FileVersion>
    <InformationalVersion>$(WavWizVersion)-beta</InformationalVersion>
    <Product>WavWiz (BETA)</Product>
    <Company>WavWiz</Company>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1507</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WavWizChannel</_Parameter1>
      <_Parameter2>$(WavWizChannel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
