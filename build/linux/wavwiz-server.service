# F166 / 0.7.0 Pi: systemd unit for a bare Linux install (x64 or Raspberry Pi arm64). See docs/LINUX.md and docs/RASPBERRY-PI.md.
# build/linux/install.sh installs it for you. By hand:
#   sudo useradd --system --home /var/lib/wavwiz --shell /usr/sbin/nologin wavwiz
#   sudo tar -C /opt -xzf wavwiz-server-<ver>-<rid>.tar.gz
#   sudo install -d -o wavwiz -g wavwiz /var/lib/wavwiz
#   sudo cp /opt/wavwiz-server/wavwiz-server.service /etc/systemd/system/ && sudo systemctl enable --now wavwiz-server
[Unit]
Description=WavWiz server (headless)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wavwiz
Group=wavwiz
Environment=WAVWIZ_DATA=/var/lib/wavwiz
# Listen on the home network. Set a specific LAN address instead of 0.0.0.0 if you prefer.
Environment=WAVWIZ_BIND=0.0.0.0
Environment=WAVWIZ_ALLOW_ALL_INTERFACES=1
Environment=WAVWIZ_HEADLESS=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Alarms and schedules use the system time zone (sudo timedatectl set-timezone America/Chicago).
ExecStart=/opt/wavwiz-server/wavwiz-server
Restart=on-failure
RestartSec=5
# Experimental AirPlay 2 output needs UDP ports 319/320 (PTP). Uncomment to allow it without running as root:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/wavwiz
PrivateTmp=true

[Install]
WantedBy=multi-user.target
